{
  "name": "peat-guard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write app components lib scripts components.json package.json next.config.ts eslint.config.mjs tsconfig.json prisma.config.ts compose.yaml README.md docs/engineering/database.md",
    "format:check": "prettier --check app components lib scripts prisma/seed.ts components.json package.json next.config.ts eslint.config.mjs tsconfig.json prisma.config.ts compose.yaml README.md docs/engineering/database.md",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "worker": "bun run scripts/worker.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mdx,yml,yaml}": "prettier --write"
  }
}
