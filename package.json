{
  "name": "peat-guard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "prebuild": "prisma generate",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts components/ lib/ app/",
    "test:unit": "bun test test/*.test.ts components/ lib/ app/",
    "test:integration": "bun test test/integration/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "format": "prettier --write app components lib scripts test e2e proxy.ts playwright.config.ts components.json package.json next.config.ts eslint.config.mjs tsconfig.json prisma.config.ts prisma/seed.ts prisma/seed-safety.ts docker/compose.dev.yaml .github/workflows/build-and-deploy.yml README.md",
    "format:check": "prettier --check app components lib scripts test e2e proxy.ts playwright.config.ts prisma/seed.ts prisma/seed-safety.ts components.json package.json next.config.ts eslint.config.mjs tsconfig.json prisma.config.ts docker/compose.dev.yaml .github/workflows/build-and-deploy.yml README.md",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:fresh": "bun run scripts/db-migrate-fresh.ts",
    "db:seed": "bun --conditions=react-server run prisma/seed.ts",
    "docker:db": "docker compose -f docker/compose.dev.yaml -p peatguard-main up -d postgres",
    "docker:up": "docker compose -f docker/compose.dev.yaml -p peatguard-main up --build",
    "docker:down": "docker compose -f docker/compose.dev.yaml -p peatguard-main down",
    "docker:logs": "docker compose -f docker/compose.dev.yaml -p peatguard-main logs -f",
    "worker": "bun --conditions=react-server scripts/worker.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/prisma-adapter": "^1.7.25",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mdx,yml,yaml}": "prettier --write"
  }
}
