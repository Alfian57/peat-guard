# Local-only Compose defaults. Change DB_PORT and WEB_PORT for parallel clones.
POSTGRES_DB=peat_guard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
WEB_PORT=3000

# Host-side tools use localhost. Compose gives the web/worker services an internal URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peat_guard?schema=public"
UPLOADS_DIR=/app/.data/uploads
BETTER_AUTH_SECRET=

# Optional integrations. Keep provider credentials server-side; the MapTiler key is public.
DEEPSEEK_API_KEY=
NASA_FIRMS_MAP_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

NEXT_TELEMETRY_DISABLED=1
