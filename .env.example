# Local-only Compose defaults. Change DB_PORT and WEB_PORT for parallel clones.
POSTGRES_DB=peat_guard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
WEB_PORT=3000

# Host-side tools use localhost. Compose gives the web/worker services an internal URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peat_guard?schema=public"
UPLOADS_DIR=/app/.data/uploads
# Leave blank for local Compose so the URL follows WEB_PORT; set the public origin when deployed.
BETTER_AUTH_URL=
# Generate locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local demo accounts are enabled by default in Compose; production always disables them.
ENABLE_DEMO_LOGIN=1

# Optional integrations. Keep provider credentials server-side; the MapTiler key is public.
DEEPSEEK_API_KEY=
NASA_FIRMS_MAP_KEY=
# Optional west,south,east,north bounds; defaults to 109,-5,117,2.
NASA_FIRMS_AREA=
# Shared sync cooldown and worker interval in minutes (5–1440).
NASA_FIRMS_SYNC_INTERVAL_MINUTES=30
NEXT_PUBLIC_MAPTILER_KEY=

NEXT_TELEMETRY_DISABLED=1
