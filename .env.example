# Local Compose defaults
POSTGRES_DB=peat_guard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
WEB_PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peat_guard?schema=public"

# File uploads
UPLOADS_DIR=/app/.data/uploads

# Better Auth
# Leave blank for local Compose so the URL follows WEB_PORT; set to public HTTPS origin when deployed.
BETTER_AUTH_URL=
# Generate locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# AI Triage
DEEPSEEK_API_KEY=

# NASA FIRMS
NASA_FIRMS_MAP_KEY=
# Optional west,south,east,north bounds; defaults to 109,-5,117,2.
NASA_FIRMS_AREA=
# Shared sync cooldown and worker interval in minutes (5–1440).
NASA_FIRMS_SYNC_INTERVAL_MINUTES=30

# MapTiler
NEXT_PUBLIC_MAPTILER_KEY=

# System
NEXT_TELEMETRY_DISABLED=1
